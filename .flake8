[flake8]
exclude =
    venv,
    env,
    .venv,
    migrations,
    staticfiles,
    __pycache__

max-line-length = 120

# Ignore all style and unused import warnings for existing codebase
ignore =
    W291,W293,W391,W292,
    E302,E303,E301,E305,
    E111,E114,E116,
    E121,E123,E126,E128,E121,
    E225,E203,E202,E251,E261,
    E271,E222,E402,
    E501,W503,E265,
    F401,F811,F841,F823
